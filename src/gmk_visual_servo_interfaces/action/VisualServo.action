# Goal: desired camera-to-target distance and maximum execution time.
float32 target_distance_m
float32 timeout_sec
---
# Result codes.
uint8 SUCCESS=0
uint8 TARGET_LOST=1
uint8 VISION_TIMEOUT=2
uint8 ACTION_TIMEOUT=3
uint8 CANCELED=4
uint8 INTERNAL_ERROR=5

uint8 code
string message
float32 final_u_error_px
float32 final_depth_error_m
---
# Feedback states.
uint8 WAITING_TARGET=0
uint8 ALIGNING_Y=1
uint8 ALIGNING_X=2
uint8 SETTLING=3

uint8 state
float32 u
float32 v
float32 depth_m
float32 confidence
float32 error_u_px
float32 error_depth_m
float32 command_vx_mps
float32 command_vy_mps
float32 elapsed_sec
