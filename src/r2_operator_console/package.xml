<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_operator_console</name>
  <version>0.0.0</version>
  <description>R2 operator console for manual cmd_vel, arm, lift, and navigation action clients.</description>
  <maintainer email="a15992282905@gmail.com">xie</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>r2_nav_interfaces</exec_depend>
  <exec_depend>techx_r2_arm_interfaces</exec_depend>
  <exec_depend>techx_r2_chassis_interfaces</exec_depend>
  <exec_depend>r2_nav_bringup</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
