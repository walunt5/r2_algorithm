<root BTCPP_format="4" main_tree_to_execute="GymTaskTree">
  <BehaviorTree ID="GymTaskTree">

    <Sequence name="Gym_Task_Tree">
      <Sequence name="Normal_Gym_Head_Pick_And_Dock">

        <R2TimedCmdVelNode
          name="DeadMove_Forward_To_Pick"
          cmd_vel_topic="/cmd_vel"
          vx="1.0"
          vy="0.00"
          wz="0.00"
          duration_sec="4.5"
          rate_hz="20.0"
          publish_stop="true" />

        <R2TimedCmdVelNode
          name="DeadMove_Forward_To_Pick"
          cmd_vel_topic="/cmd_vel"
          vx="0.00"
          vy="0.00"
          wz="0.00"
          duration_sec="0.1"
          rate_hz="20.0"
          publish_stop="true" />

        <Script code=" head_dock_success := 1 " />
        <Script code=" gym_task_done := 1 " />

      </Sequence>

      <ScriptCondition code=" gym_task_done == 1 " />

      <R2ForceSuccess name="Gym_Task_Return_Success" />

    </Sequence>

  </BehaviorTree>
</root>
