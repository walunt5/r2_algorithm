<root BTCPP_format="4" main_tree_to_execute="GymTaskTree">
  <BehaviorTree ID="GymTaskTree">

    <Sequence name="Gym_Task_Tree">
      <Sequence name="Normal_Gym_Head_Pick_And_Dock">
          <!-- 红方 -->
        <R2OdinRelativeMoveActionNode
            name="Odin_Move_Forward_1m"
            action_name="/r2_odin_relative_move"
            forward_m="0.8"
            lateral_m="0.0"
            timeout_sec="30.0"
            server_timeout_ms="3000"
            result_grace_ms="2000" />

          <!-- 蓝方 -->

        <!-- <R2OdinRelativeMoveActionNode
            name="Odin_Move_Forward_1m"
            action_name="/r2_odin_relative_move"
            forward_m="0.8"
            lateral_m="0.7"
            timeout_sec="30.0"
            server_timeout_ms="3000"
            result_grace_ms="2000" /> -->

          <RetryUntilSuccessful name="WeaponVisualServo_RetryUntilSuccess" num_attempts="-1">
            <R2WeaponVisualServoActionNode
              name="WeaponVisualServo"
              action_name="/weapon_visual_servo"
              target_distance_m="0.5"
              timeout_sec="15.0"
              server_timeout_ms="3000"
              result_grace_ms="2000"
              result_code="{servo_result_code}"
              result_message="{servo_result_message}"
              final_u_error_px="{servo_final_u_error_px}"
              final_depth_error_m="{servo_final_depth_error_m}" />
          </RetryUntilSuccessful>

        <!-- 4. 底盘升高到 64 mm -->
          <R2LiftControlNode
            name="Lift_To_63mm"
            target_h_mm="64"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="1.0"
            rate_hz="30.0"
            publish_stop="true" />

          <!-- 5. 下发夹爪机械臂平放指令 -->
          <R2ExecuteArmActionNode
            name="GripperArm_Flat"
            action_name="/r2_arm/execute_action"
            target_id="1"
            action_id="257"
            timeout_ms="8000"
            param="0"
            flags="0"
            result_timeout_ms="10000" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.5"
            rate_hz="20.0"
            publish_stop="true" />

          <R2LiftControlNode
            name="Lift_To_63mm"
            target_h_mm="63"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />
          
          <R2TimedCmdVelNode
            name="DeadMove_Forward_To_Fist"
            cmd_vel_topic="/cmd_vel"
            vx="0.20"
            vy="0.00"
            wz="0.00"
            duration_sec="3.0"
            rate_hz="30.0"
            publish_stop="false" />

          <R2TimedCmdVelNode
            name="DeadMove_Forward_To_Fist"
            cmd_vel_topic="/cmd_vel"
            vx="0.10"
            vy="0.00"
            wz="0.00"
            duration_sec="0.7"
            rate_hz="30.0"
            publish_stop="true" />
          
          <R2ExecuteArmActionNode
            name="Gripper_Close"
            action_name="/r2_arm/execute_action"
            target_id="4"
            action_id="1026"
            timeout_ms="3000"
            param="0"
            flags="0"
            result_timeout_ms="5000" />

          <!-- 8. 延迟 1 秒：用 0 速度保持 1 秒 -->
          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.9"
            rate_hz="20.0"
            publish_stop="true" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.5"
            rate_hz="20.0"
            publish_stop="true" />


           <R2LiftControlNode
            name="Lift_To_63mm"
            target_h_mm="66"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="1.00"
            rate_hz="20.0"
            publish_stop="true" />

          <R2ExecuteArmActionNode
            name="GripperArm_Rotate_90"
            action_name="/r2_arm/execute_action"
            target_id="1"
            action_id="258"
            timeout_ms="8000"
            param="0"
            flags="0"
            result_timeout_ms="10000" />

          <R2TimedCmdVelNode
            name="DeadMove_Forward_To_Fist"
            cmd_vel_topic="/cmd_vel"
            vx="-0.30"
            vy="0.00"
            wz="0.00"
            duration_sec="1.5"
            rate_hz="30.0"
            publish_stop="true" />

          <R2TimedCmdVelNode
            name="DeadMove_Forward_To_Fist"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.9"
            rate_hz="30.0"
            publish_stop="true" />
          
          <R2LiftControlNode
            name="Lift_To_63mm"
            target_h_mm="2.5"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

          <R2TimedCmdVelNode
            name="DeadMove_Backward_After_Pick"
            cmd_vel_topic="/cmd_vel"
            vx="-0.5"
            vy="0.00"
            wz="0.00"
            duration_sec="1.5"
            rate_hz="20.0"
            publish_stop="true" />

          <R2TimedCmdVelNode
            name="DeadMove_Backward_After_Pick"
            cmd_vel_topic="/cmd_vel"
            vx="0.0"
            vy="0.00"
            wz="0.00"
            duration_sec="0.5"
            rate_hz="20.0"
            publish_stop="true" />

          <!-- 12. 死动作：原地旋转一段时间 -->
          <R2OdinRelativeRotateActionNode
            name="Odin_Rotate_Left_90deg"
            action_name="/r2_odin_relative_rotate"
            target_yaw_rad="-3.139"
            timeout_sec="30.0"
            server_timeout_ms="3000"
            result_grace_ms="2000"
            result_code="{rotate_result_code}"
            result_message="{rotate_result_message}"
            final_yaw_error_rad="{rotate_final_yaw_error_rad}" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.30"
            rate_hz="20.0"
            publish_stop="true" />

          <R2WaitForLightSignalActionNode
            action_name="/r2_light_signal/wait"
            timeout_sec="1000.0"
            server_timeout_ms="3000"
            result_grace_ms="2000" />

          <R2ExecuteArmActionNode
            name="Gripper_Close"
            action_name="/r2_arm/execute_action"
            target_id="4"
            action_id="1025"
            timeout_ms="3000"
            param="0"
            flags="0"
            result_timeout_ms="5000" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.30"
            rate_hz="20.0"
            publish_stop="true" />
          
          <R2ExecuteArmActionNode
            name="GripperArm_Flat"
            action_name="/r2_arm/execute_action"
            target_id="1"
            action_id="257"
            timeout_ms="8000"
            param="0"
            flags="0"
            result_timeout_ms="10000" /> 

      </Sequence>

      <ScriptCondition code=" gym_task_done == 1 " />

      <R2ForceSuccess name="Gym_Task_Return_Success" />

    </Sequence>

  </BehaviorTree>
</root>
