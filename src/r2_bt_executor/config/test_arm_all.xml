<root BTCPP_format="4" main_tree_to_execute="GymTaskTree">
  <BehaviorTree ID="GymTaskTree">
    <Sequence name="Gym_Task_Tree">
      <Sequence name="Normal_Gym_Head_Pick_And_Dock">
        <ForceSuccess name="WeaponVisualServo_ForceSuccess">
          <R2WeaponVisualServoActionNode
            name="WeaponVisualServo"
            action_name="/weapon_visual_servo"
            target_distance_m="0.45"
            timeout_sec="18"
            server_timeout_ms="3000"
            result_grace_ms="2000"
            result_code="{servo_result_code}"
            result_message="{servo_result_message}"
            final_u_error_px="{servo_final_u_error_px}"
            final_depth_error_m="{servo_final_depth_error_m}" />
        </ForceSuccess>
      </Sequence>

      <ScriptCondition code=" gym_task_done == 1 " />

      <R2ForceSuccess name="Gym_Task_Return_Success" />
    </Sequence>
  </BehaviorTree>
</root>
