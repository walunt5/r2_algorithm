<root BTCPP_format="4" main_tree_to_execute="GymTaskTree">
  <BehaviorTree ID="GymTaskTree">

    <Sequence name="Gym_Task_Tree">

      <Script code=" gym_task_done := 0 " />
      <Script code=" head_dock_success := 0 " />

      <Fallback name="Gym_Task_With_Cleanup">

        <Sequence name="Normal_Gym_Head_Pick_And_Dock">

          <!-- 1. 导航到夹取端头预设点 -->
          <!-- <R2NavigateToPoseActionNode
            name="Nav_To_GYM_HEAD_PICK_PRESET"
            action_name="/r2_navigate_to_pose"
            goal_name="GYM_HEAD_PICK_PRESET"
            control_mode="fixed_map"
            timeout_sec="60.0"
            server_timeout_ms="3000"
            result_timeout_ms="70000" /> -->

          <!-- 4. 底盘升高到 64 mm -->
          <R2LiftControlNode
            name="Lift_To_63mm"
            target_h_mm="64"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="2.0"
            rate_hz="20.0"
            publish_stop="true" />

          <!-- 5. 下发夹爪机械臂平放指令 -->
          <R2ExecuteArmActionNode
            name="GripperArm_Flat"
            action_name="/r2_arm/execute_action"
            target_id="1"
            action_id="257"
            timeout_ms="8000"
            param="0"
            flags="0"
            result_timeout_ms="10000" />

          <!-- 6. 死动作：往前走一段时间 -->
          <R2TimedCmdVelNode
            name="DeadMove_Forward_To_Fist"
            cmd_vel_topic="/cmd_vel"
            vx="0.50"
            vy="0.00"
            wz="0.00"
            duration_sec="0.5"
            rate_hz="20.0"
            publish_stop="true" />

          <!-- 7. 下发夹爪闭合指令 -->
          <R2ExecuteArmActionNode
            name="Gripper_Close"
            action_name="/r2_arm/execute_action"
            target_id="4"
            action_id="1026"
            timeout_ms="3000"
            param="0"
            flags="0"
            result_timeout_ms="5000" />

          <!-- 8. 延迟 1 秒：用 0 速度保持 1 秒 -->
          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="1.00"
            rate_hz="20.0"
            publish_stop="true" />

          <!-- 4. 底盘升高到 66 m -->
          <R2LiftControlNode
            name="Lift_To_63mm"
            target_h_mm="66"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

          <!-- 9. 下发夹爪机械臂旋转到 90 度指令 -->
          <R2ExecuteArmActionNode
            name="GripperArm_Rotate_90"
            action_name="/r2_arm/execute_action"
            target_id="1"
            action_id="258"
            timeout_ms="8000"
            param="0"
            flags="0"
            result_timeout_ms="10000" />

          <!-- 10. 死动作：vx 往后退一段时间 -->
          <R2TimedCmdVelNode
            name="DeadMove_Backward_After_Pick"
            cmd_vel_topic="/cmd_vel"
            vx="-0.4"
            vy="0.00"
            wz="0.00"
            duration_sec="2.0"
            rate_hz="20.0"
            publish_stop="true" />

          <!-- 11. 控制底盘下降到 3 mm。
               注意：LiftControl 的 target_h_mm 是 int32，不能写 2.5。
               如果你说的 2.5 是 2.5 cm，请把这里改成 25。 -->
          <R2LiftControlNode
            name="Lift_Down_To_3mm"
            target_h_mm="3"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

          <!-- 12. 死动作：原地旋转一段时间 -->
          <R2TimedCmdVelNode
            name="DeadRotate_After_Lift_Down"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="-1.5"
            duration_sec="7.2"
            rate_hz="20.0"
            publish_stop="true" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.30"
            rate_hz="20.0"
            publish_stop="true" />

          <R2WaitForLightSignalActionNode
            action_name="/r2_light_signal/wait"
            timeout_sec="10.0"
            server_timeout_ms="3000"
            result_grace_ms="2000" />

          <R2ExecuteArmActionNode
            name="Gripper_Close"
            action_name="/r2_arm/execute_action"
            target_id="4"
            action_id="1025"
            timeout_ms="3000"
            param="0"
            flags="0"
            result_timeout_ms="5000" />

          <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.30"
            rate_hz="20.0"
            publish_stop="true" />            
          

          <R2ExecuteArmActionNode
            name="GripperArm_Flat"
            action_name="/r2_arm/execute_action"
            target_id="1"
            action_id="257"
            timeout_ms="8000"
            param="0"
            flags="0"
            result_timeout_ms="10000" />          

          <!-- 13. 导航到 GYM_HEAD_AFTER_PICK_ALIGN -->
          <!-- <R2NavigateToPoseActionNode
            name="Nav_To_GYM_HEAD_AFTER_PICK_ALIGN"
            action_name="/r2_navigate_to_pose"
            goal_name="GYM_HEAD_AFTER_PICK_ALIGN"
            control_mode="x_then_y"
            timeout_sec="60.0"
            server_timeout_ms="3000"
            result_timeout_ms="70000" /> -->

          <!-- 14. 死动作：最后后退一段时间 -->
          <!-- <R2TimedCmdVelNode
            name="DeadMove_Final_Backward"
            cmd_vel_topic="/cmd_vel"
            vx="-0.20"
            vy="0.00"
            wz="0.00"
            duration_sec="0.60"
            rate_hz="20.0"
            publish_stop="true" /> -->

          <Script code=" head_dock_success := 1 " />
          <Script code=" gym_task_done := 1 " />

        </Sequence>

        <!-- 失败清理：如果主流程任意一步失败，执行安全收尾 -->
        <Sequence name="Gym_Task_Failure_Cleanup">

          <R2TimedCmdVelNode
            name="Stop_Chassis_On_Failure"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="0.20"
            rate_hz="20.0"
            publish_stop="true" />

          <R2ExecuteArmActionNode
            name="Open_Gripper_On_Failure"
            action_name="/r2_arm/execute_action"
            target_id="4"
            action_id="1025"
            timeout_ms="3000"
            param="0"
            flags="0"
            result_timeout_ms="5000" />

          <R2LiftControlNode
            name="Lift_Down_On_Failure"
            target_h_mm="3"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

          <R2ExecuteArmActionNode
            name="Arm_Flat_On_Failure"
            action_name="/r2_arm/execute_action"
            target_id="1"
            action_id="257"
            timeout_ms="8000"
            param="0"
            flags="0"
            result_timeout_ms="10000" />

          <Script code=" head_dock_success := 0 " />
          <Script code=" gym_task_done := 0 " />

          <R2ForceSuccess name="Failure_Cleanup_Finished" />

        </Sequence>

      </Fallback>

      <ScriptCondition code=" gym_task_done == 1 " />

      <R2ForceSuccess name="Gym_Task_Return_Success" />

    </Sequence>

  </BehaviorTree>
</root>