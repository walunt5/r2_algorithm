<root BTCPP_format="4" main_tree_to_execute="Zone3CompetitionTree">
  <BehaviorTree ID="Zone3CompetitionTree">
    <Sequence name="Zone3_Competition_Task_Placeholder">
      <R2TimedCmdVelNode
            name="Wait_1s_After_Gripper_Close"
            cmd_vel_topic="/cmd_vel"
            vx="0.00"
            vy="0.00"
            wz="0.00"
            duration_sec="6.0"
            rate_hz="30.0"
            publish_stop="true" />

      <R2LiftControlNode
            name="Lift_Down_To_3mm"
            target_h_mm="8"
            mask="7"
            timeout_sec="15.0"
            result_timeout_ms="18000" />

      <R2OdinRelativeMoveActionNode
            name="Odin_Move_Forward_1m"
            action_name="/r2_odin_relative_move"
            forward_m="3.4"
            lateral_m="0.0"
            timeout_sec="30.0"
            server_timeout_ms="3000"
            result_grace_ms="2000" />
      <R2WaitForever name="Zone3_Formal_Task_Not_Configured" />
    </Sequence>
  </BehaviorTree>
</root>
