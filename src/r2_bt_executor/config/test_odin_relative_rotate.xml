<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="test_odin_relative_rotate">
      <R2OdinRelativeRotateActionNode
        name="Odin_Rotate_Left_90deg"
        action_name="/r2_odin_relative_rotate"
        target_yaw_rad="-1.5708"
        timeout_sec="8.0"
        server_timeout_ms="3000"
        result_grace_ms="2000"
        result_code="{rotate_result_code}"
        result_message="{rotate_result_message}"
        final_yaw_error_rad="{rotate_final_yaw_error_rad}" />
    </Sequence>
  </BehaviorTree>
</root>
